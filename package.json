{
  "name": "cobwebs",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/clean-dist.js && vite build && npm run build:embed && npm run build:generator && npm run build:extension && npm run pack:extension",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "format": "prettier --write src tests *.js *.json index.html README.md",
    "build:embed": "vite build --config vite.embed.config.js",
    "build:generator": "vite build --config vite.generator.config.js",
    "build:extension": "vite build --config vite.extension.config.js",
    "pack:extension": "node scripts/pack-extension.js"
  },
  "devDependencies": {
    "vite": "^8.0.0",
    "@playwright/test": "^1.58.0",
    "prettier": "^3.8.0"
  }
}
